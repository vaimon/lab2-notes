    <!-- TODO(ipc-6): объявите здесь собственное разрешение
         edu.androidsec.notes.permission.READ_NOTES с protectionLevel="signature"
         (см. TitlesProvider.kt). -->

    <application
        android:name=".NotesApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notes">

        <!-- TODO(ipc-1): у КАЖДОГО компонента в итоговом (merged) манифесте должен быть явно
             задан android:exported, а экспортированы только лаунчер, провайдер заголовков и
             компоненты, закрытые разрешением уровня signature.
             Merged manifest включает компоненты библиотек: посмотрите его во вкладке
             Merged Manifest в Android Studio или командой scripts/check.sh manifest.
             Для каждого экспортированного компонента библиотеки разберитесь, кто может его
             вызвать. Ненужный компонент убирается через tools:node="remove"; на защите
             объясните, почему убрали или оставили. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- TODO(ipc-3): intent-filter для deep link notes://note/<id> (см. NoteDeepLink.kt). -->
        </activity>

        <!-- TODO(ipc-4): объявите ресивер .reminder.ReminderActionReceiver, закрытый для других
             приложений (см. ReminderActionReceiver.kt). -->

        <!-- TODO(ipc-5): объявите androidx.core.content.FileProvider с authority
